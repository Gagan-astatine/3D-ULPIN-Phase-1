# Optional. With no token the application uses OpenStreetMap and flat WGS84 ground.
VITE_CESIUM_ION_TOKEN=
# Set true for a completely network-free schematic ground after installation.
VITE_OFFLINE_MODE=false
# Optional full app URL (including subdirectory) for phone / shared certificate QR links.
# For local phone scanning, use this computer's LAN IP and Vite port on the same Wi-Fi.
VITE_PUBLIC_APP_URL=
